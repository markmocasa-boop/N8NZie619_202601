    {
      "parameters": {
        "jsCode": "// ============================================\n// KORRIGIERTER CODE - Version 6.0\n// ============================================\n\nconst allItems = $input.all();\n\nconsole.log('=== DEBUG START ===');\nconsole.log('Anzahl Items empfangen:', allItems.length);\n\nlet ean = '';\nlet produktname = '';\n\ntry {\n  const originalData = $('📝 Set Data').first().json;\n  ean = originalData.ean || '';\n  produktname = originalData.produktname || '';\n  console.log('EAN aus Set Data:', ean);\n  console.log('Produktname aus Set Data:', produktname);\n} catch (e) {\n  console.log('Set Data Zugriff fehlgeschlagen, nutze Fallback');\n  for (const item of allItems) {\n    const url = item.json.url || item.json.loadedUrl || '';\n    \n    const eanMatch1 = url.match(/[?&]_ean=(\\d{8,14})/);\n    if (eanMatch1 && !ean) ean = eanMatch1[1];\n    \n    const eanMatch2 = url.match(/[?&]q=(\\d{8,14})(?:&|$)/);\n    if (eanMatch2 && !ean) ean = eanMatch2[1];\n    \n    const sMatch = url.match(/[?&]sSearch=([^&]+)/);\n    if (sMatch && !produktname) {\n      const decoded = decodeURIComponent(sMatch[1].replace(/\\+/g, ' '));\n      if (!/^\\d+$/.test(decoded) && decoded.length > 3) {\n        produktname = decoded;\n      }\n    }\n    \n    const qMatch = url.match(/[?&]q=([^&]+)/);\n    if (qMatch && !produktname) {\n      const decoded = decodeURIComponent(qMatch[1].replace(/\\+/g, ' '));\n      if (!/^\\d+$/.test(decoded) && decoded.length > 3) {\n        produktname = decoded;\n      }\n    }\n  }\n}\n\nif (!ean) {\n  return [{ json: { error: 'Keine EAN gefunden', skip: true } }];\n}\n\nfunction extractKeywords(text) {\n  if (!text) return [];\n  return text.toLowerCase()\n    .replace(/[^a-zäöüß0-9\\s]/g, ' ')\n    .split(/\\s+/)\n    .filter(w => w.length > 2)\n    .filter(w => !['für', 'mit', 'und', 'oder', 'von', 'bei', 'das', 'die', 'der', 'den', 'dem', 'motorsäge', 'motorsage'].includes(w));\n}\n\nconst blacklistKeywords = ['puzzle', 'perlen', 'bead', 'socken', 'spielzeug', 'hülle', 'cover', 'tasche', 'poster', 'sticker', 'shirt', 'hosen', 'kabel', 'adapter', 'set', 'bundle', 'paket', 'zubehör', 'ersatzteil', 'kette', 'schwert', 'schiene'];\nconst referenceKeywords = extractKeywords(produktname);\n\nconst result = {\n  ean: ean,\n  produktname: produktname,\n  timestamp: new Date().toLocaleString('de-DE'),\n  shopPrices: {},\n  cheapestShop: null,\n  cheapestPrice: null,\n  cheapestUrl: null,\n  lohmeierPrice: null,\n  totalShopsFound: 0,\n  debug: {\n    totalItemsReceived: allItems.length,\n    sourcesProcessed: [],\n    itemsPerSource: {},\n    urlsFound: []\n  }\n};\n\nconst allShops = {\n  'otto': 'Otto',\n  'amazon': 'Amazon',\n  'ebay': 'eBay',\n  'kaufland': 'Kaufland',\n  'idealo': 'Idealo',\n  'galaxus': 'Galaxus',\n  'conrad': 'Conrad',\n  'manomano': 'ManoMano',\n  'grube': 'Grube.de',\n  'lohmeier': 'Lohmeier',\n  'motorland': 'Motorland',\n  'agrieuro': 'Agrieuro',\n  'simon': 'Simon-Profi-Technik'\n};\n\nconst modelMatch = produktname.match(/\\b(\\d{3})\\b/);\nconst modelNumber = modelMatch ? modelMatch[1] : null;\n\nfor (const item of allItems) {\n  if (item.json.error || item.json.code === 'ECONNABORTED') {\n    console.log('Item übersprungen wegen Fehler:', item.json.error || item.json.code);\n    continue;\n  }\n  \n  const text = item.json.text || item.json.markdown || '';\n  const sourceUrl = item.json.url || item.json.loadedUrl || '';\n  \n  if (sourceUrl) {\n    result.debug.urlsFound.push(sourceUrl.substring(0, 100));\n  }\n  \n  if (text.length < 50) {\n    console.log('Item übersprungen - Text zu kurz:', text.length, 'URL:', sourceUrl.substring(0, 50));\n    continue;\n  }\n  \n  let sourceShop = null;\n  if (sourceUrl.includes('preispiraten.de')) sourceShop = 'preispiraten';\n  else if (sourceUrl.includes('lohmeier.shop')) sourceShop = 'lohmeier';\n  else if (sourceUrl.includes('motorland.de')) sourceShop = 'motorland';\n  else if (sourceUrl.includes('agrieuro.de')) sourceShop = 'agrieuro';\n  else if (sourceUrl.includes('simon-profi-technik.de')) sourceShop = 'simon';\n  \n  console.log('Verarbeite Source:', sourceShop, 'URL:', sourceUrl.substring(0, 60));\n  \n  if (sourceShop && !result.debug.sourcesProcessed.includes(sourceShop)) {\n    result.debug.sourcesProcessed.push(sourceShop);\n  }\n  result.debug.itemsPerSource[sourceShop || 'unknown'] = \n    (result.debug.itemsPerSource[sourceShop || 'unknown'] || 0) + 1;\n  \n  const lines = text.split('\\n');\n  \n  for (let i = 0; i < lines.length; i++) {\n    const line = lines[i];\n    const priceMatch = line.match(/([\\d.]+,\\d{2})\\s*€/);\n    if (!priceMatch) continue;\n    \n    const price = parseFloat(priceMatch[1].replace(/\\./g, '').replace(',', '.'));\n    if (price < 50 || price > 50000) continue;\n    \n    const context = lines.slice(Math.max(0, i - 8), i + 8).join(' ').toLowerCase();\n    \n    let isBlacklisted = false;\n    for (const kw of blacklistKeywords) {\n      if (context.includes(kw)) {\n        isBlacklisted = true;\n        break;\n      }\n    }\n    if (isBlacklisted) continue;\n    \n    let isValid = false;\n    \n    if (context.includes(ean)) {\n      isValid = true;\n    }\n    \n    if (!isValid && modelNumber && context.includes(modelNumber)) {\n      isValid = true;\n    }\n    \n    if (!isValid) {\n      let matchCount = 0;\n      for (const kw of referenceKeywords) {\n        if (context.includes(kw)) matchCount++;\n      }\n      if (matchCount >= 2) {\n        isValid = true;\n      }\n    }\n    \n    if (!isValid && price >= 400 && price <= 2500) {\n      isValid = true;\n    }\n    \n    if (!isValid) continue;\n    \n    if (sourceShop && sourceShop !== 'preispiraten') {\n      if (!result.shopPrices[sourceShop] || price < result.shopPrices[sourceShop].price) {\n        result.shopPrices[sourceShop] = { \n          name: allShops[sourceShop], \n          price: price, \n          url: sourceUrl\n        };\n        console.log('Direct Shop Preis gefunden:', sourceShop, price);\n        if (sourceShop === 'lohmeier') result.lohmeierPrice = price;\n      }\n      continue;\n    }\n    \n    if (sourceShop === 'preispiraten') {\n      for (const key of Object.keys(allShops)) {\n        const regex = new RegExp('\\\\b' + key + '\\\\b', 'i');\n        if (regex.test(context)) {\n          if (!result.shopPrices[key] || price < result.shopPrices[key].price) {\n            result.shopPrices[key] = { \n              name: allShops[key], \n              price: price, \n              url: sourceUrl\n            };\n            console.log('Preispiraten Shop Preis gefunden:', key, price);\n            if (key === 'lohmeier') result.lohmeierPrice = price;\n          }\n          break;\n        }\n      }\n    }\n  }\n}\n\nlet cheapestShop = null;\nlet cheapestPrice = Infinity;\nlet cheapestUrl = null;\n\nfor (const key of Object.keys(result.shopPrices)) {\n  const shop = result.shopPrices[key];\n  if (shop.price < cheapestPrice) {\n    cheapestPrice = shop.price;\n    cheapestShop = shop.name;\n    cheapestUrl = shop.url;\n  }\n}\n\nresult.cheapestShop = cheapestShop;\nresult.cheapestPrice = cheapestPrice !== Infinity ? cheapestPrice : null;\nresult.cheapestUrl = cheapestUrl;\nresult.totalShopsFound = Object.keys(result.shopPrices).length;\nresult.foundShops = Object.keys(result.shopPrices);\n\nconsole.log('=== DEBUG END ===');\nconsole.log('Sources verarbeitet:', result.debug.sourcesProcessed);\nconsole.log('Shops gefunden:', result.foundShops);\nconsole.log('Total Items:', result.debug.totalItemsReceived);\n\nif (result.debug.sourcesProcessed.length < 3) {\n  result.warning = 'Nur ' + result.debug.sourcesProcessed.length + ' von 5 Quellen verarbeitet: ' + result.debug.sourcesProcessed.join(', ');\n}\n\nreturn [{ json: result }];"
      },
      "id": "dc4d5657-025f-4c1b-a07e-dce9c8a30e05",
      "name": "🔗 Process All Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2384,
        832
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $input.first().json;\n\nif (p.skip || p.error || !p.ean) {\n  return [];\n}\n\nconst today = new Date().toLocaleDateString('de-DE');\nconst formatPrice = (price) => price ? price.toFixed(2).replace('.', ',') : null;\nconst getPrice = (key) => formatPrice(p.shopPrices?.[key]?.price);\n\nconst output = {\n  Datum: today,\n  EAN: p.ean,\n  Produktname: p.produktname || ''\n};\n\nif (getPrice('lohmeier')) output.Lohmeier = getPrice('lohmeier');\nif (getPrice('motorland')) output.Motorland = getPrice('motorland');\nif (getPrice('agrieuro')) output.Agrieuro = getPrice('agrieuro');\nif (getPrice('simon')) output.Simon = getPrice('simon');\nif (getPrice('otto')) output.Otto = getPrice('otto');\nif (getPrice('amazon')) output.Amazon = getPrice('amazon');\nif (getPrice('ebay')) output.eBay = getPrice('ebay');\nif (getPrice('kaufland')) output.Kaufland = getPrice('kaufland');\nif (getPrice('idealo')) output.Idealo = getPrice('idealo');\nif (getPrice('galaxus')) output.Galaxus = getPrice('galaxus');\nif (getPrice('conrad')) output.Conrad = getPrice('conrad');\nif (getPrice('manomano')) output.ManoMano = getPrice('manomano');\nif (p.cheapestShop) output.Guenstigster_Shop = p.cheapestShop;\nif (p.cheapestPrice) output.Guenstigster_Preis = formatPrice(p.cheapestPrice);\nif (p.cheapestUrl) output.Guenstigster_URL = p.cheapestUrl;\nif (p.totalShopsFound > 0) output.Anzahl_Shops = p.totalShopsFound;\n\nreturn [{ json: output }];"
      },
      "id": "e6d7d083-ec2e-44a6-86a1-5506a692bdb6",
